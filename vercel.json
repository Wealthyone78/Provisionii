{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "out",
  "git": {
    "deploymentEnabled": false
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=31536000,immutable"
        }
      ]
    },
    {
      "source": "/provisionii-logo.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/solutions",
      "permanent": true
    },
    {
      "source": "/talent",
      "destination": "/careers",
      "permanent": true
    },
    {
      "source": "/find-work",
      "destination": "/careers",
      "permanent": true
    },
    {
      "source": "/jobs",
      "destination": "/careers",
      "permanent": true
    },
    {
      "source": "/organizations",
      "destination": "/find-talent",
      "permanent": true
    },
    {
      "source": "/contactus.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/workforce-solutions",
      "destination": "/solutions",
      "permanent": true
    },
    {
      "source": "/workforce-solutions/contract-to-hire",
      "destination": "/workforce-solutions/contract-staffing#contract-to-hire",
      "permanent": true
    }
  ]
}
